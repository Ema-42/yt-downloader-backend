# Orígenes permitidos, separados por coma (en producción: la URL de Vercel)
CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005
# Opcional: regex para permitir previews de Vercel
# CORS_ORIGIN_REGEX=https://mi-app-.*\.vercel\.app
DOWNLOADS_DIR=downloads
MAX_FILE_AGE_HOURS=2
MAX_FILESIZE_MB=500
# Archivo cookies.txt exportado del navegador (en Render: /etc/secrets/cookies.txt)
COOKIES_FILE=cookies.txt
# Solo local: navegador del que yt-dlp lee cookies (chrome, firefox, edge, brave). Vacío en servidores.
COOKIES_FROM_BROWSER=
